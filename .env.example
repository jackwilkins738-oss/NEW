NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Settings -> API -> service_role key (secret!). Powers /admin (creating
# customers and invite links). Never prefix this with NEXT_PUBLIC_ - it
# must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend -> API Keys -> create one. Powers the "new lead" notification
# email sent to a tenant's members. Different from the SMTP credentials
# used for Supabase Auth emails (password reset, invites) - this is a
# separate integration, Resend's own API rather than SMTP.
RESEND_API_KEY=your-resend-api-key

# sentry.io -> create a free project (choose "Next.js") -> Settings ->
# Client Keys (DSN). Public by design (like a Stripe publishable key or
# the Supabase anon key above) - safe in NEXT_PUBLIC_, it only lets
# events be sent in, not read back out. Reports runtime errors
# automatically; leave unset and the app runs exactly the same, just
# without error reporting.
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# console.cloud.google.com -> new project -> enable the Google Calendar API
# -> OAuth consent screen -> Credentials -> OAuth client ID (Web
# application), with redirect URI
# https://admin.scalardigital.co.uk/api/calendar/google/callback. Powers
# each customer's own "Connect Google Calendar" button - not required for
# the rest of the app to work.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Any random string you generate yourself (a password generator's fine).
# Vercel automatically sends this as a bearer token on every scheduled
# cron run (see vercel.json) - without it, /api/cron/weekly-digest would
# be a public URL anyone could hit to trigger emails.
CRON_SECRET=any-random-string

# Outreach prospects (migration 041). A long random string (32+ characters)
# shared with the Scalar website's own PROSPECTS_API_SECRET and the owner's
# import script - it's the only thing guarding /api/prospects/*, which is
# where the prospect list lives (kept out of both public repos on purpose).
# Unset = those routes refuse everything.
PROSPECTS_API_SECRET=generate-a-long-random-string
# Where prospects' preview pages live, for the "Open their preview" links on
# the dashboard's Prospects panel.
PROSPECT_PREVIEW_BASE_URL=https://www.scalardigital.co.uk

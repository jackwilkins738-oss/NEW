NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Settings -> API -> service_role key (secret!). Powers /admin (creating
# customers and invite links). Never prefix this with NEXT_PUBLIC_ - it
# must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend -> API Keys -> create one. Powers the "new lead" notification
# email sent to a tenant's members. Different from the SMTP credentials
# used for Supabase Auth emails (password reset, invites) - this is a
# separate integration, Resend's own API rather than SMTP.
RESEND_API_KEY=your-resend-api-key
